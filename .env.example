# Runtime: public project configuration; never put a secret in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://127.0.0.1:3000
# Optional, server only. Required only to deliver currently published media.
SUPABASE_SECRET_KEY=
# Operational scripts only; never used by Next.js, never committed with values.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ADMIN_EMAIL=
